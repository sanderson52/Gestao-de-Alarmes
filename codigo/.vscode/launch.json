{
  "version": "0.2.0",
  "configurations": [
    { "name": "IHM de alarmes (servidor + navegador)", "type": "debugpy", "request": "launch",
      "program": "${workspaceFolder}/servidor_ihm.py", "cwd": "${workspaceFolder}", "console": "integratedTerminal" },
    { "name": "Testes automatizados (unittest)", "type": "debugpy", "request": "launch",
      "module": "unittest", "args": ["-v", "test_automacao.py"], "cwd": "${workspaceFolder}", "console": "integratedTerminal" },
    { "name": "Comparativo da simulação A x B", "type": "debugpy", "request": "launch",
      "program": "${workspaceFolder}/cenario_compressor.py", "cwd": "${workspaceFolder}", "console": "integratedTerminal" },
    { "name": "Demonstração original da P1", "type": "debugpy", "request": "launch",
      "program": "${workspaceFolder}/automacao.py", "cwd": "${workspaceFolder}", "console": "integratedTerminal",
      "env": { "PYTHONUNBUFFERED": "1" } }
  ]
}
